    "Expires %@. Anyone with this code can take over your Callbacks, so only use it on your own device." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@に期限切れになります。このコードを持つ人は誰でも Callback を引き継げるため、自分のデバイスでのみ使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 만료됩니다. 이 코드를 가진 사람은 누구나 Callback을 가져갈 수 있으므로 본인 기기에서만 사용하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
